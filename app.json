{
  "expo": {
    "name": "LeanLog",
    "slug": "umarcoc93",
    "scheme": "leanlog",
    "version": "2.9.21",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F0E1"
    },
    "android": {
      "package": "com.calorietracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F0E1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "./plugins/withAsyncStorageCapacity",
      "./plugins/withLeanLogShortcuts",
      "./plugins/withWidgetThemeFonts",
      [
        "expo-image-picker",
        {
          "photosPermission": "App ini perlukan akses galeri untuk analisa makanan.",
          "cameraPermission": "App ini perlukan akses kamera untuk ambil gambar makanan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6542",
          "androidMode": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LeanLogDaily",
              "label": "LeanLog Daily",
              "description": "Daily health with your choice of account snapshots or spending guards.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LeanLogAccount",
              "label": "LeanLog Account",
              "description": "A live balance for one RedCoins account.",
              "minWidth": "180dp",
              "minHeight": "90dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LeanLogCashReality",
              "label": "LeanLog Cash Reality",
              "description": "True spendable cash, cards owed and selected cash.",
              "minWidth": "250dp",
              "minHeight": "90dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LeanLogQuickLog",
              "label": "LeanLog Quick Log",
              "description": "Open food and RedCoins loggers from the home screen.",
              "minWidth": "250dp",
              "minHeight": "55dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LeanLogAutomation",
              "label": "LeanLog Bills & Automation",
              "description": "Upcoming RedCoins reminders and auto-log transactions.",
              "minWidth": "250dp",
              "minHeight": "90dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow LeanLog to show today's agenda from your calendar."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "086aadb6-658c-47ee-a472-e9d76ac3c7be"
      }
    },
    "owner": "umiaqs-team"
  }
}
