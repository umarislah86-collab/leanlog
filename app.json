{
  "expo": {
    "name": "LeanLog",
    "slug": "umarcoc93",
    "scheme": "leanlog",
    "version": "2.9.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F0E1"
    },
    "android": {
      "package": "com.calorietracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F0E1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "App ini perlukan akses galeri untuk analisa makanan.",
          "cameraPermission": "App ini perlukan akses kamera untuk ambil gambar makanan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6542",
          "androidMode": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LeanLogDaily",
              "label": "LeanLog Daily",
              "description": "Calories, steps, cash reality and quick logging at a glance.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow LeanLog to show today's agenda from your calendar."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "624ee9c5-768a-4781-a2c5-1f1608c1500a"
      }
    },
    "owner": "umarosli93"
  }
}
